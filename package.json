{
  "name": "bleep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BLEEP: think alike, speak in code. A Futile Studio multiplayer adaptation of Decrypto.",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "e2e": "tsx e2e/play.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayurJivani/Bleep.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MayurJivani/Bleep/issues"
  },
  "homepage": "https://github.com/MayurJivani/Bleep#readme",
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/doto": "^5.3.0",
    "express": "^5.3.0",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  }
}
